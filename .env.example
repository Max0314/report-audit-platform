# 测试报告审核平台 - 本地/独立运行环境模板
#
# 注意：在本仓库的「一键合并部署」下，本文件不会被使用——
# 部署时的配置来自仓库根目录的 ./.env.runtime-service
# 与 docker-compose.report-audit-platform.yml（AI_API_KEY 默认复用 DASHSCOPE_API_KEY）。
# 这里仅供单独本地调试（python -m uvicorn app.main:app）时参考。

# AI 服务配置
# 支持的 provider: dashscope (阿里云百炼) / deepseek
AI_PROVIDER=dashscope
AI_API_KEY=replace-with-real-dashscope-api-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_TIMEOUT=120
AI_ENABLE_THINKING=false

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENV=production
SERVER_DEBUG=false
