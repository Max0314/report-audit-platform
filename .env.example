# 测试报告审核平台 - 独立部署环境模板
# 复制为 .env，填写真实值后设置权限 600；.env 不得提交 Git。

# AI 服务配置
# 支持的 provider: dashscope (阿里云百炼) / deepseek
AI_PROVIDER=dashscope
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4000
AI_TIMEOUT=120
AI_ENABLE_THINKING=false

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENV=production
SERVER_DEBUG=false

# NeoFlow 宿主机回环发布端口；容器内仍监听 8000。
REPORT_AUDIT_PUBLISH_PORT=39023

# 文件持久化（生产必须为 oss）。复用硬件门户私有 bucket，但使用独立前缀。
# 建议为本服务配置仅允许 prod/report-audit/* 的独立 RAM AccessKey。
STORAGE_BACKEND=oss
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=neoflow-neo-hardware
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=prod/report-audit

# 复用硬件门户登录。INTERNAL_SECRET 与硬件门户 NEO_INTERNAL_SECRET 同值，
# 只写服务器 .env，不进入 Git；容器通过共享 Docker 网络访问 htmlsystm。
HARDWARE_AUTH_ENABLED=true
HARDWARE_AUTH_INTERNAL_URL=http://htmlsystm:8000
HARDWARE_AUTH_INTERNAL_SECRET=
HARDWARE_AUTH_LOGIN_URL=/neo_hardware/login
HARDWARE_AUTH_PUBLIC_PREFIX=/neo_hardware/report-audit
HARDWARE_AUTH_TIMEOUT_SECONDS=10
HARDWARE_AUTH_CACHE_TTL_SECONDS=10
